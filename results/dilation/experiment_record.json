{
    "architecture": "U-Net with DILATION bottleneck",
    "mechanism": "dilation",
    "seed": 42,
    "resolution": "128x128",
    "augmentation": "RandomHorizontalFlip(p=0.5), ColorJitter(brightness=0.15, contrast=0.15)",
    "optimizer": {
        "type": "AdamW",
        "lr": 0.001,
        "weight_decay": 0.0001,
        "scheduler": "CosineAnnealingLR"
    },
    "stopping_rule": "Fixed budget 8 epochs with checkpointing on best val mIoU",
    "parameter_budget": {
        "total_parameters": 2657202,
        "trainable_parameters": 2657202
    },
    "data_contract": {
        "dataset_name": "Oxford-IIIT Pet Semantic Segmentation",
        "citation": "Parkhi et al., Cats and Dogs, IEEE CVPR 2012",
        "resolution": [
            128,
            128
        ],
        "classes": {
            "0": "background",
            "1": "pet_foreground"
        },
        "ignored_label": 255,
        "trimap_raw_mapping": {
            "1": 1,
            "2": 0,
            "3": 255
        },
        "image_channels": 3,
        "normalization": {
            "mean": [
                0.485,
                0.456,
                0.406
            ],
            "std": [
                0.229,
                0.224,
                0.225
            ]
        },
        "split_ratios": {
            "train": 0.7,
            "val": 0.15,
            "test": 0.15
        },
        "mask_interpolation": "NEAREST",
        "image_interpolation": "BILINEAR"
    }
}